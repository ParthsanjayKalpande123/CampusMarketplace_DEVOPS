# ==========================================================
# Campus Marketplace — Environment Configuration Template
# ==========================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ==========================================================

# ----------------------------------------------------------
# APPLICATION
# ----------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_NAME=Campus Marketplace

# ----------------------------------------------------------
# DATABASE
# ----------------------------------------------------------
# Local development (direct MongoDB):
#   mongodb://localhost:27017/campus_marketplace
#
# Docker Compose (uses service name, not localhost):
#   mongodb://mongodb:27017/campus_marketplace
#
# Production with credentials:
#   mongodb://<user>:<password>@<host>:27017/campus_marketplace
#
MONGODB_URI=mongodb://localhost:27017/campus_marketplace

# ----------------------------------------------------------
# JWT
# ----------------------------------------------------------
# Use a long, random string in production (minimum 64 chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-very-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# ----------------------------------------------------------
# COOKIES
# ----------------------------------------------------------
# Set COOKIE_SECURE=true in production (requires HTTPS).
COOKIE_SECURE=false
# Options: lax | strict | none
COOKIE_SAME_SITE=lax

# ----------------------------------------------------------
# CORS
# ----------------------------------------------------------
# Comma-separated list of allowed origins.
# In production, set this to your actual domain.
CORS_ORIGIN=http://localhost:3000

# ----------------------------------------------------------
# LOGGING
# ----------------------------------------------------------
# Options: error | warn | info | debug
LOG_LEVEL=info

# ----------------------------------------------------------
# OPTIONAL AI FEATURES (Google Gemini)
# ----------------------------------------------------------
# Obtain an API key from Google AI Studio and keep it secret.
# When unset, AI endpoints return HTTP 503 and explain that setup is required.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Required for Kibana alerting and encrypted saved objects.
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this value stable across restarts and deployments; do not commit the real key.
KIBANA_ENCRYPTION_KEY=
