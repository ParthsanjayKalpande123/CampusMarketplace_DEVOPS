# ==========================================================
# Campus Marketplace — .dockerignore
# ==========================================================
# Keeps the Docker build context lean and secure.
# Finalized in Phase 7 (Docker).
# ==========================================================

# Node modules (installed inside container via npm ci)
node_modules/

# Environment secrets (injected at runtime via --env-file)
.env
.env.*

# Git metadata
.git/
.gitignore

# Tests (not needed at runtime)
tests/
coverage/

# Documentation
*.md
docs/

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# IaC and deployment configs (not needed in app image)
terraform/
ansible/
ansible.cfg
docker/

# GitHub Actions
.github/
