<%# src/views/partials/admin-sidebar.ejs %>
<%# Requires: currentPath — set by setLocals; adminBase is '' on the dedicated admin port %>
<% const adminRoot = typeof adminBase !== 'undefined' ? adminBase : '/admin'; %>
<nav class="cm-admin-sidebar d-flex flex-column">
  <div class="cm-admin-brand px-4 py-3 border-bottom">
    <a href="/" class="cm-brand text-decoration-none d-flex align-items-center gap-2">
      <i class="bi bi-shop"></i>CampusMarket
    </a>
    <span class="badge bg-danger mt-1" style="font-size:0.65rem;letter-spacing:.06em;">ADMIN</span>
  </div>

  <div class="px-3 py-3 flex-grow-1">
    <p class="cm-sidebar-label px-2 mb-2">Management</p>
    <ul class="list-unstyled mb-0">
      <li class="mb-1">
        <a href="<%= adminRoot %>/dashboard"
          class="cm-sidebar-link <%= currentPath === '/admin/dashboard' || currentPath === '/dashboard' ? 'active' : '' %>">
          <i class="bi bi-grid me-2"></i>Dashboard
        </a>
      </li>
      <li class="mb-1">
        <a href="<%= adminRoot %>/users"
          class="cm-sidebar-link <%= currentPath === '/admin/users' ? 'active' : '' %>">
          <i class="bi bi-people me-2"></i>Users
        </a>
      </li>
      <li class="mb-1">
        <a href="<%= adminRoot %>/reports"
          class="cm-sidebar-link <%= currentPath === '/admin/reports' ? 'active' : '' %>">
          <i class="bi bi-flag me-2"></i>Reports
        </a>
      </li>
    </ul>

  </div>

  <div class="px-3 py-3 border-top">
    <div class="d-flex align-items-center gap-2 mb-2">
      <div class="cm-seller-avatar cm-seller-avatar-sm d-flex align-items-center justify-content-center">
        <i class="bi bi-person-fill" style="font-size:.9rem;"></i>
      </div>
      <div class="overflow-hidden">
        <p class="fw-semibold mb-0 small text-truncate"><%= user.name %></p>
        <p class="text-muted mb-0" style="font-size:.75rem;">Administrator</p>
      </div>
    </div>
    <button class="btn btn-sm btn-outline-danger w-100" id="adminLogoutBtn">
      <i class="bi bi-box-arrow-right me-1"></i>Logout
    </button>
  </div>
</nav>
