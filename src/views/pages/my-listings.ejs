<!DOCTYPE html>
<html lang="en" class="h-100">
<%- include('../partials/head', { title }) %>
<body class="d-flex flex-column h-100 cm-bg">

<%- include('../partials/navbar') %>

<main class="flex-grow-1 py-5">
  <div class="container">

    <div class="d-flex align-items-center justify-content-between mb-4">
      <h1 class="cm-page-title mb-0">My Listings</h1>
      <a href="/post" class="btn cm-btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i>Post New Item
      </a>
    </div>

    <div id="pageAlert" class="alert d-none"></div>

    <% if (products.length === 0) { %>
      <div class="cm-empty-state text-center py-5">
        <i class="bi bi-box-seam" style="font-size:3rem; color:var(--color-muted);"></i>
        <h3 class="mt-3 mb-1">No listings yet</h3>
        <p class="text-muted">Post your first item to start selling on campus.</p>
        <a href="/post" class="btn cm-btn-primary mt-2">Post an Item</a>
      </div>
    <% } else { %>

      <!-- Summary stats -->
      <%
        const counts = { available: 0, sold: 0, exchanged: 0, inactive: 0 };
        products.forEach(p => { if (counts[p.status] !== undefined) counts[p.status]++; });
      %>
      <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
          <div class="cm-stat-card cm-stat-available">
            <span class="cm-stat-num"><%= counts.available %></span>
            <span class="cm-stat-label">Active</span>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="cm-stat-card cm-stat-sold">
            <span class="cm-stat-num"><%= counts.sold %></span>
            <span class="cm-stat-label">Sold</span>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="cm-stat-card cm-stat-exchanged">
            <span class="cm-stat-num"><%= counts.exchanged %></span>
            <span class="cm-stat-label">Exchanged</span>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="cm-stat-card cm-stat-inactive">
            <span class="cm-stat-num"><%= counts.inactive + products.length - counts.available - counts.sold - counts.exchanged - counts.inactive %></span>
            <span class="cm-stat-label">Inactive</span>
          </div>
        </div>
      </div>

      <!-- Listings table -->
      <div class="cm-table-wrap">
        <table class="table cm-listings-table mb-0">
          <thead>
            <tr>
              <th>Item</th>
              <th>Price</th>
              <th>Condition</th>
              <th>Status</th>
              <th>Listed</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% products.forEach(function(product) { %>
              <%
                const condMap = { 'new':'New','like-new':'Like New','good':'Good','fair':'Fair','poor':'Poor' };
                const statusMap = {
                  'available': 'badge-available',
                  'sold':      'badge-sold',
                  'exchanged': 'badge-exchanged',
                  'inactive':  'badge-inactive',
                };
                const listedDate = new Date(product.createdAt).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'});
              %>
              <tr id="row-<%= product._id %>">
                <td>
                  <a href="/listings/<%= product._id %>" class="cm-link fw-medium">
                    <%= product.title.length > 50 ? product.title.substring(0, 47) + '...' : product.title %>
                  </a>
                  <% if (product.category) { %>
                    <br/><span class="text-muted small"><%= product.category.name %></span>
                  <% } %>
                </td>
                <td class="fw-semibold">Rs. <%= product.price.toLocaleString('en-IN') %></td>
                <td><span class="text-muted"><%= condMap[product.condition] || product.condition %></span></td>
                <td>
                  <span class="cm-status-badge <%= statusMap[product.status] || 'badge-inactive' %>">
                    <%= product.status.charAt(0).toUpperCase() + product.status.slice(1) %>
                  </span>
                </td>
                <td class="text-muted small"><%= listedDate %></td>
                <td class="text-end">
                  <div class="d-flex justify-content-end gap-2 flex-wrap">
                    <a href="/listings/<%= product._id %>/edit" class="btn btn-sm btn-light">
                      <i class="bi bi-pencil"></i>
                    </a>
                    <% if (product.status === 'available') { %>
                      <button
                        class="btn btn-sm btn-outline-success"
                        title="Mark as Sold"
                        data-action="update-status"
                        data-product-id="<%= product._id %>"
                        data-status="sold"
                      ><i class="bi bi-check-circle"></i></button>
                      <button
                        class="btn btn-sm btn-outline-warning"
                        title="Deactivate"
                        data-action="update-status"
                        data-product-id="<%= product._id %>"
                        data-status="inactive"
                      ><i class="bi bi-pause-circle"></i></button>
                    <% } else if (product.status === 'inactive') { %>
                      <button
                        class="btn btn-sm btn-outline-primary"
                        title="Reactivate"
                        data-action="update-status"
                        data-product-id="<%= product._id %>"
                        data-status="available"
                      ><i class="bi bi-play-circle"></i></button>
                    <% } %>
                    <button
                      class="btn btn-sm btn-outline-danger"
                      title="Delete"
                      data-action="delete-product"
                      data-product-id="<%= product._id %>"
                    ><i class="bi bi-trash"></i></button>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

    <% } %>

  </div>
</main>

<%- include('../partials/footer') %>

<script
  src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
  integrity="sha384-YvpcrYf0tY3lHB60NNkmXc4s9bIOgUxi8T/jzmVwGS0h2VbFfBzJlDa/K/VOh4v"
  crossorigin="anonymous"
></script>
<script src="/js/main.js"></script>
<script src="/js/my-listings.js"></script>

</body>
</html>
