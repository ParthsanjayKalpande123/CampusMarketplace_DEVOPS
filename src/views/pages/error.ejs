<!DOCTYPE html>
<html lang="en" class="h-100">
<%- include('../partials/head', { title }) %>
<body class="d-flex flex-column h-100 cm-bg">

<main class="flex-grow-1 d-flex align-items-center py-5">
  <div class="container text-center">
    <div class="cm-error-wrap mx-auto">
      <p class="cm-error-code"><%= statusCode %></p>
      <h1 class="cm-error-title mb-3"><%= statusCode === 404 ? 'Page Not Found' : 'Something Went Wrong' %></h1>
      <p class="text-muted mb-4"><%= message %></p>
      <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center">
        <a href="/" class="btn cm-btn-primary">Go to Marketplace</a>
        <button class="btn btn-light" type="button" id="goBackBtn">Go Back</button>
      </div>
    </div>
  </div>
</main>

<script
  src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
  integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
  crossorigin="anonymous"
></script>

</body>
</html>
