<!DOCTYPE html>
<html lang="en">
<%- include('../../partials/head', { title }) %>
<body class="cm-admin-body">
<div class="cm-admin-layout">

  <%- include('../../partials/admin-sidebar') %>

  <div class="cm-admin-main">

    <!-- Top bar -->
    <header class="cm-admin-topbar d-flex justify-content-between align-items-center px-4 py-3">
      <h1 class="cm-page-title mb-0">Dashboard</h1>
      <span class="text-muted small">
        <%= new Date().toLocaleDateString('en-IN', { weekday:'long', day:'numeric', month:'long', year:'numeric' }) %>
      </span>
    </header>

    <div class="p-4">

      <div id="adminAlert" class="alert d-none" role="alert"></div>

        <div class="cm-admin-card-header d-flex justify-content-between align-items-center">
          <h2 class="cm-admin-card-title mb-0">Add Listing</h2>
          <span class="text-muted small">Created under your admin account</span>
        </div>
        <form id="adminListingForm" class="p-3">
          <div class="row g-3">
            <div class="col-md-6"><label class="form-label" for="adminTitle">Title</label><input class="form-control" id="adminTitle" required minlength="3" maxlength="200"></div>
            <div class="col-md-3"><label class="form-label" for="adminPrice">Price (Rs.)</label><input class="form-control" id="adminPrice" type="number" min="0" max="999999" required></div>
            <div class="col-md-8"><label class="form-label" for="adminDescription">Description</label><textarea class="form-control" id="adminDescription" minlength="10" maxlength="2000" required></textarea></div>
            <div class="col-md-2"><label class="form-label" for="adminCondition">Condition</label><select class="form-select" id="adminCondition" required><option value="new">New</option><option value="like-new">Like New</option><option value="good" selected>Good</option><option value="fair">Fair</option><option value="poor">Poor</option></select></div>
            <div class="col-md-2"><label class="form-label" for="adminLocation">Location</label><input class="form-control" id="adminLocation" maxlength="200"></div>
          </div>
          <button class="btn cm-btn-primary mt-3" type="submit"><i class="bi bi-plus-lg me-1"></i>Create Listing</button>
        </form>
      </div>

      <!-- ── Stat cards ──────────────────────────────────────────── -->
      <div class="row g-3 mb-5">
        <div class="col-6 col-lg-3">
          <div class="cm-admin-stat-card">
            <div class="cm-admin-stat-icon cm-stat-users"><i class="bi bi-people-fill"></i></div>
            <p class="cm-admin-stat-num"><%= stats.totalUsers %></p>
            <p class="cm-admin-stat-label">Total Users</p>
          </div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="cm-admin-stat-card">
            <div class="cm-admin-stat-icon cm-stat-listings"><i class="bi bi-box-seam-fill"></i></div>
            <p class="cm-admin-stat-num"><%= stats.totalProducts %></p>
            <p class="cm-admin-stat-label">Total Listings</p>
          </div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="cm-admin-stat-card">
            <div class="cm-admin-stat-icon cm-stat-active"><i class="bi bi-check-circle-fill"></i></div>
            <p class="cm-admin-stat-num"><%= stats.availableProducts %></p>
            <p class="cm-admin-stat-label">Active Listings</p>
          </div>
        </div>
        <div class="col-6 col-lg-3">
          <div class="cm-admin-stat-card">
            <div class="cm-admin-stat-icon cm-stat-reports"><i class="bi bi-flag-fill"></i></div>
            <p class="cm-admin-stat-num"><%= stats.pendingReports %></p>
            <p class="cm-admin-stat-label">Pending Reports</p>
          </div>
        </div>
      </div>

      <div class="row g-4">

        <% if (stats.flaggedListings && stats.flaggedListings.length) { %>
          <div class="col-12">
            <div class="cm-admin-card">
              <div class="cm-admin-card-header"><h2 class="cm-admin-card-title mb-0">AI-flagged listings — human review required</h2></div>
              <div class="table-responsive"><table class="table cm-listings-table mb-0"><thead><tr><th>Listing</th><th>Seller</th><th>AI risk flags</th><th>Review</th></tr></thead><tbody>
                <% stats.flaggedListings.forEach(function(p) { %><tr>
                  <td><a href="/listings/<%= p._id %>"><%= p.title %></a></td>
                  <td><%= p.seller ? p.seller.name : 'Unknown' %></td>
                  <td><%= p.aiRiskFlags.join(', ') %></td>
                  <td><a class="btn btn-sm btn-outline-primary" href="/listings/<%= p._id %>">Inspect</a></td>
                </tr><% }); %>
              </tbody></table></div>
            </div>
          </div>
        <% } %>

        <div class="col-12 col-xl-5">
          <div class="cm-admin-card h-100">
            <div class="cm-admin-card-header"><h2 class="cm-admin-card-title mb-0">Listings by Location</h2></div>
            <% if (stats.listingsByLocation.length === 0) { %><p class="text-muted p-3 mb-0">No location data yet.</p><% } else { %>
              <div class="table-responsive"><table class="table cm-listings-table mb-0"><thead><tr><th>Location</th><th class="text-end">Listings</th></tr></thead><tbody><% stats.listingsByLocation.forEach(function(item) { %><tr><td><%= item._id %></td><td class="text-end fw-semibold"><%= item.count %></td></tr><% }); %></tbody></table></div>
            <% } %>
          </div>
        </div>

        <div class="col-12 col-xl-7">
          <div class="cm-admin-card h-100">
            <div class="cm-admin-card-header d-flex justify-content-between align-items-center"><h2 class="cm-admin-card-title mb-0">Pending Reports</h2><a href="/reports?status=pending" class="btn btn-sm btn-light">View all</a></div>
            <% if (stats.recentReports.length === 0) { %><p class="text-muted p-3 mb-0">No pending reports.</p><% } else { %>
              <div class="table-responsive"><table class="table cm-listings-table mb-0"><thead><tr><th>Listing</th><th>Reason</th><th class="text-end">Action</th></tr></thead><tbody><% stats.recentReports.forEach(function(r) { %><tr id="dashboard-report-<%= r._id %>"><td><%= r.product ? r.product.title : 'Deleted listing' %></td><td><%= r.reason %></td><td class="text-end"><% if (r.product) { %><button class="btn btn-sm btn-outline-danger me-1" data-dashboard-delete="<%= r.product._id %>" data-report-id="<%= r._id %>">Delete</button><% } %><button class="btn btn-sm btn-outline-success" data-dashboard-keep="<%= r._id %>">Keep</button></td></tr><% }); %></tbody></table></div>
            <% } %>
          </div>
        </div>

        <!-- ── Recent Listings ──────────────────────────────────── -->
        <div class="col-12 col-xl-7">
          <div class="cm-admin-card">
            <div class="cm-admin-card-header d-flex justify-content-between align-items-center">
              <h2 class="cm-admin-card-title mb-0">Recent Listings</h2>
              <a href="/" class="btn btn-sm btn-light">View all</a>
            </div>
            <% if (stats.recentProducts.length === 0) { %>
              <p class="text-muted p-3 mb-0">No listings yet.</p>
            <% } else { %>
              <div class="table-responsive">
                <table class="table cm-listings-table mb-0">
                  <thead><tr>
                    <th>Title</th><th>Seller</th><th>Price</th><th>Status</th><th class="text-end">Action</th>
                  </tr></thead>
                  <tbody>
                    <% stats.recentProducts.forEach(function(p) { %>
                      <%
                        const sMap = {available:'badge-available',sold:'badge-sold',exchanged:'badge-exchanged',inactive:'badge-inactive'};
                      %>
                      <tr id="dashboard-listing-<%= p._id %>">
                        <td><a href="/listings/<%= p._id %>" class="cm-link fw-medium">
                          <%= p.title.length > 40 ? p.title.substring(0,37)+'...' : p.title %>
                        </a></td>
                        <td class="text-muted small"><%= p.seller ? p.seller.name : 'N/A' %></td>
                        <td class="fw-semibold">Rs. <%= p.price.toLocaleString('en-IN') %></td>
                        <td><span class="cm-status-badge <%= sMap[p.status] || 'badge-inactive' %>">
                          <%= p.status.charAt(0).toUpperCase() + p.status.slice(1) %>
                        </span></td>
                        <td class="text-end"><button class="btn btn-sm btn-outline-danger" type="button" data-admin-delete="<%= p._id %>">Delete</button></td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </div>
        </div>

        <!-- ── Recent Users ─────────────────────────────────────── -->
        <div class="col-12 col-xl-5">
          <div class="cm-admin-card">
            <div class="cm-admin-card-header d-flex justify-content-between align-items-center">
              <h2 class="cm-admin-card-title mb-0">Recent Users</h2>
              <a href="/users" class="btn btn-sm btn-light">View all</a>
            </div>
            <% if (stats.recentUsers.length === 0) { %>
              <p class="text-muted p-3 mb-0">No users yet.</p>
            <% } else { %>
              <ul class="list-unstyled mb-0 p-3">
                <% stats.recentUsers.forEach(function(u) { %>
                  <li class="d-flex align-items-center gap-3 mb-3">
                    <div class="cm-seller-avatar cm-seller-avatar-sm d-flex align-items-center justify-content-center">
                      <i class="bi bi-person-fill" style="font-size:.9rem;"></i>
                    </div>
                    <div class="flex-grow-1 overflow-hidden">
                      <p class="fw-medium mb-0 small text-truncate"><%= u.name %></p>
                      <p class="text-muted mb-0 small text-truncate"><%= u.email %></p>
                    </div>
                    <span class="badge <%= u.role === 'admin' ? 'bg-danger' : 'bg-light text-dark border' %>" style="font-size:.7rem;">
                      <%= u.role %>
                    </span>
                  </li>
                <% }); %>
              </ul>
            <% } %>
          </div>
        </div>

      </div><!-- /row -->
    </div><!-- /p-4 -->
  </div><!-- /cm-admin-main -->
</div><!-- /cm-admin-layout -->

<script
  src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
  integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
  crossorigin="anonymous"
></script>
<script src="/js/main.js"></script>
<script>
  const ab = document.getElementById('adminLogoutBtn');
  if (ab) ab.addEventListener('click', window.CampusMarket.logout);

  const adminApi = '/api/v1/admin';
  const adminAlert = (message, type = 'success') => {
    const alert = document.getElementById('adminAlert');
    alert.className = `alert alert-${type}`;
    alert.textContent = message;
  };
  document.getElementById('adminListingForm').addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.currentTarget;
    const payload = {
      title: document.getElementById('adminTitle').value,
      description: document.getElementById('adminDescription').value,
      category: document.getElementById('adminCategory').value,
      price: document.getElementById('adminPrice').value,
      condition: document.getElementById('adminCondition').value,
      location: document.getElementById('adminLocation').value,
    };
    const response = await fetch(`${adminApi}/products`, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
    if (response.ok) { form.reset(); adminAlert('Listing created successfully.'); } else { const body = await response.json(); adminAlert(body.error?.message || 'Could not create listing.', 'danger'); }
  });
  document.querySelectorAll('[data-dashboard-keep]').forEach((button) => button.addEventListener('click', async () => {
    const response = await fetch(`${adminApi}/reports/${button.dataset.dashboardKeep}/status`, { method: 'PATCH', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ status: 'resolved' }) });
    if (response.ok) document.getElementById(`dashboard-report-${button.dataset.dashboardKeep}`).remove(); else adminAlert('Could not update report.', 'danger');
  }));
  document.querySelectorAll('[data-dashboard-delete]').forEach((button) => button.addEventListener('click', async () => {
    const response = await fetch(`${adminApi}/products/${button.dataset.dashboardDelete}`, { method: 'DELETE', credentials: 'same-origin' });
    if (!response.ok) { adminAlert('Could not delete listing.', 'danger'); return; }
    await fetch(`${adminApi}/reports/${button.dataset.reportId}/status`, { method: 'PATCH', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ status: 'resolved' }) });
    document.getElementById(`dashboard-report-${button.dataset.reportId}`).remove();
  }));
  document.querySelectorAll('[data-admin-delete]').forEach((button) => button.addEventListener('click', async () => {
    if (!window.confirm('Delete this listing permanently?')) return;
    button.disabled = true;
    const response = await fetch(`${adminApi}/products/${button.dataset.adminDelete}`, { method: 'DELETE', credentials: 'same-origin' });
    if (!response.ok) { adminAlert('Could not delete listing.', 'danger'); button.disabled = false; return; }
    document.getElementById(`dashboard-listing-${button.dataset.adminDelete}`).remove();
    adminAlert('Listing deleted successfully.');
  }));
</script>
</body>
</html>
