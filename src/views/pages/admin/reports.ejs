<!DOCTYPE html>
<html lang="en">
<%- include('../../partials/head', { title }) %>
<body class="cm-admin-body">
<div class="cm-admin-layout">

  <%- include('../../partials/admin-sidebar') %>

  <div class="cm-admin-main">
    <header class="cm-admin-topbar d-flex justify-content-between align-items-center px-4 py-3">
      <h1 class="cm-page-title mb-0">Manage Reports</h1>
      <span class="text-muted small"><%= pagination.total %> report<%= pagination.total !== 1 ? 's' : '' %></span>
    </header>

    <div class="p-4">

      <!-- Filter -->
      <form action="/admin/reports" method="GET" class="d-flex flex-wrap gap-2 mb-4">
        <select name="status" class="form-select cm-form-control" style="max-width:180px;">
          <option value="" <%= !query.status ? 'selected' : '' %>>All Statuses</option>
          <option value="pending"  <%= query.status === 'pending'  ? 'selected' : '' %>>Pending</option>
          <option value="reviewed" <%= query.status === 'reviewed' ? 'selected' : '' %>>Reviewed</option>
          <option value="resolved" <%= query.status === 'resolved' ? 'selected' : '' %>>Resolved</option>
        </select>
        <a href="/admin/reports" class="btn btn-light">Clear</a>
      </form>

      <div id="reportsAlert" class="alert d-none"></div>

      <div class="cm-admin-card">
        <% if (reports.length === 0) { %>
          <p class="text-muted p-4 mb-0">No reports found.</p>
        <% } else { %>
          <div class="table-responsive">
            <table class="table cm-listings-table mb-0">
              <thead><tr>
                <th>Listing</th>
                <th>Reported By</th>
                <th>Reason</th>
                <th>Details</th>
                <th>Status</th>
                <th>Date</th>
                <th class="text-end">Actions</th>
              </tr></thead>
              <tbody>
                <% reports.forEach(function(r) { %>
                  <%
                    const statusMap = {
                      pending:  'bg-warning text-dark',
                      reviewed: 'bg-info text-dark',
                      resolved: 'bg-success text-white',
                    };
                    const reasonMap = {
                      spam: 'Spam', inappropriate: 'Inappropriate', wrong_price: 'Wrong Price',
                      item_unavailable: 'Unavailable', fraud: 'Fraud', other: 'Other',
                    };
                  %>
                  <tr id="report-row-<%= r._id %>">
                    <td>
                      <% if (r.product) { %>
                        <a href="/listings/<%= r.product._id %>" class="cm-link fw-medium" target="_blank">
                          <%= r.product.title ? (r.product.title.length > 35 ? r.product.title.substring(0,32)+'...' : r.product.title) : 'Deleted' %>
                        </a>
                      <% } else { %>
                        <span class="text-muted">Deleted</span>
                      <% } %>
                    </td>
                    <td class="text-muted small">
                      <%= r.reportedBy ? r.reportedBy.name : 'Unknown' %>
                    </td>
                    <td>
                      <span class="cm-condition-badge">
                        <%= reasonMap[r.reason] || r.reason %>
                      </span>
                    </td>
                    <td class="text-muted small" style="max-width:200px;">
                      <span title="<%= r.description || '' %>">
                        <%= r.description ? (r.description.length > 50 ? r.description.substring(0,47)+'...' : r.description) : '—' %>
                      </span>
                    </td>
                    <td>
                      <span class="badge <%= statusMap[r.status] || 'bg-secondary' %>" style="font-size:.75rem;">
                        <%= r.status.charAt(0).toUpperCase() + r.status.slice(1) %>
                      </span>
                    </td>
                    <td class="text-muted small">
                      <%= new Date(r.createdAt).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %>
                    </td>
                    <td class="text-end">
                      <div class="d-flex justify-content-end gap-2">
                        <% if (r.status === 'pending') { %>
                          <button
                            class="btn btn-sm btn-outline-info"
                            data-action="update-report-status"
                            data-report-id="<%= r._id %>"
                            data-status="reviewed"
                          >Review</button>
                        <% } %>
                        <% if (r.status !== 'resolved') { %>
                          <button
                            class="btn btn-sm btn-outline-success"
                            data-action="update-report-status"
                            data-report-id="<%= r._id %>"
                            data-status="resolved"
                          >Resolve</button>
                        <% } %>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>

          <!-- Pagination -->
          <% if (pagination.pages > 1) { %>
            <div class="p-3 border-top">
              <nav aria-label="Reports pagination">
                <ul class="pagination justify-content-center cm-pagination mb-0">
                  <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
                    <a class="page-link" href="?<%= new URLSearchParams({...query, page: pagination.page - 1}).toString() %>">&laquo;</a>
                  </li>
                  <% for (let p = 1; p <= pagination.pages; p++) { %>
                    <li class="page-item <%= p === pagination.page ? 'active' : '' %>">
                      <a class="page-link" href="?<%= new URLSearchParams({...query, page: p}).toString() %>"><%= p %></a>
                    </li>
                  <% } %>
                  <li class="page-item <%= pagination.page >= pagination.pages ? 'disabled' : '' %>">
                    <a class="page-link" href="?<%= new URLSearchParams({...query, page: pagination.page + 1}).toString() %>">&raquo;</a>
                  </li>
                </ul>
              </nav>
            </div>
          <% } %>
        <% } %>
      </div><!-- /cm-admin-card -->
    </div><!-- /p-4 -->
  </div><!-- /cm-admin-main -->
</div><!-- /cm-admin-layout -->

<script
  src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
  integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
  crossorigin="anonymous"
></script>
<script src="/js/main.js"></script>
<script src="/js/admin-reports.js"></script>
<script>
  const ab = document.getElementById('adminLogoutBtn');
  if (ab) ab.addEventListener('click', window.CampusMarket.logout);
</script>
</body>
</html>
