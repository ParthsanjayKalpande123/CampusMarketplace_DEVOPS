<!DOCTYPE html>
<html lang="en">
<%- include('../../partials/head', { title }) %>
<body class="cm-admin-body">
<div class="cm-admin-layout">

  <%- include('../../partials/admin-sidebar') %>

  <div class="cm-admin-main">
    <header class="cm-admin-topbar d-flex justify-content-between align-items-center px-4 py-3">
      <h1 class="cm-page-title mb-0">Manage Users</h1>
      <span class="text-muted small"><%= pagination.total %> user<%= pagination.total !== 1 ? 's' : '' %> total</span>
    </header>

    <div class="p-4">

      <!-- Search + Filter -->
      <form action="/admin/users" method="GET" class="d-flex flex-wrap gap-2 mb-4">
        <input
          type="search"
          name="q"
          class="form-control cm-form-control"
          style="max-width:280px;"
          placeholder="Search by name or email"
          value="<%= query.q || '' %>"
        />
        <select name="role" class="form-select cm-form-control" style="max-width:160px;" onchange="this.form.submit()">
          <option value="" <%= !query.role ? 'selected' : '' %>>All Roles</option>
          <option value="student" <%= query.role === 'student' ? 'selected' : '' %>>Student</option>
          <option value="admin"   <%= query.role === 'admin'   ? 'selected' : '' %>>Admin</option>
        </select>
        <button class="btn cm-btn-primary" type="submit">Search</button>
        <a href="/admin/users" class="btn btn-light">Clear</a>
      </form>

      <div id="usersAlert" class="alert d-none"></div>

      <div class="cm-admin-card">
        <% if (users.length === 0) { %>
          <p class="text-muted p-4 mb-0">No users found.</p>
        <% } else { %>
          <div class="table-responsive">
            <table class="table cm-listings-table mb-0">
              <thead><tr>
                <th>Name</th>
                <th>Email</th>
                <th>College</th>
                <th>Role</th>
                <th>Joined</th>
                <th class="text-end">Actions</th>
              </tr></thead>
              <tbody>
                <% users.forEach(function(u) { %>
                  <tr id="user-row-<%= u._id %>">
                    <td class="fw-medium"><%= u.name %></td>
                    <td class="text-muted small"><%= u.email %></td>
                    <td class="text-muted small"><%= u.college || '—' %></td>
                    <td>
                      <span class="badge <%= u.role === 'admin' ? 'bg-danger' : 'bg-light text-dark border' %>"
                        style="font-size:.75rem;">
                        <%= u.role %>
                      </span>
                    </td>
                    <td class="text-muted small">
                      <%= new Date(u.createdAt).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %>
                    </td>
                    <td class="text-end">
                      <% if (u.role === 'student') { %>
                        <button
                          class="btn btn-sm btn-outline-danger"
                          title="Promote to Admin"
                          data-action="change-role"
                          data-user-id="<%= u._id %>"
                          data-role="admin"
                        >Make Admin</button>
                      <% } else { %>
                        <button
                          class="btn btn-sm btn-outline-secondary"
                          title="Demote to Student"
                          data-action="change-role"
                          data-user-id="<%= u._id %>"
                          data-role="student"
                        >Make Student</button>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>

          <!-- Pagination -->
          <% if (pagination.pages > 1) { %>
            <div class="p-3 border-top">
              <nav aria-label="Users pagination">
                <ul class="pagination justify-content-center cm-pagination mb-0">
                  <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
                    <a class="page-link" href="?<%= new URLSearchParams({...query, page: pagination.page - 1}).toString() %>">&laquo;</a>
                  </li>
                  <% for (let p = 1; p <= pagination.pages; p++) { %>
                    <li class="page-item <%= p === pagination.page ? 'active' : '' %>">
                      <a class="page-link" href="?<%= new URLSearchParams({...query, page: p}).toString() %>"><%= p %></a>
                    </li>
                  <% } %>
                  <li class="page-item <%= pagination.page >= pagination.pages ? 'disabled' : '' %>">
                    <a class="page-link" href="?<%= new URLSearchParams({...query, page: pagination.page + 1}).toString() %>">&raquo;</a>
                  </li>
                </ul>
              </nav>
            </div>
          <% } %>
        <% } %>
      </div><!-- /cm-admin-card -->
    </div><!-- /p-4 -->
  </div><!-- /cm-admin-main -->
</div><!-- /cm-admin-layout -->

<script
  src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
  integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
  crossorigin="anonymous"
></script>
<script src="/js/main.js"></script>
<script src="/js/admin-users.js"></script>
<script>
  const ab = document.getElementById('adminLogoutBtn');
  if (ab) ab.addEventListener('click', window.CampusMarket.logout);
</script>
</body>
</html>
