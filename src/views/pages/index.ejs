<!DOCTYPE html>
<html lang="en" class="h-100">
<%- include('../partials/head', { title }) %>
<body class="d-flex flex-column h-100 cm-bg">

<%- include('../partials/navbar') %>

<!-- Hero search bar -->
<section class="cm-hero py-4 py-lg-5">
  <div class="container">
    <div class="row align-items-center g-4">
      <div class="col-lg-7 text-center text-lg-start">
        <p class="cm-hero-kicker mb-2"><i class="bi bi-mortarboard me-1"></i>YOUR CAMPUS, YOUR MARKETPLACE</p>
        <h1 class="cm-hero-title mb-2">Find What You Need on Campus</h1>
        <p class="cm-hero-subtitle mb-4">Buy, sell and exchange useful finds within your college community.</p>
        <form class="cm-hero-search mx-auto mx-lg-0" action="/" method="GET">
          <div class="input-group input-group-lg">
            <input
              type="search"
              name="q"
              class="form-control"
              placeholder="Search textbooks, electronics, cycles..."
              value="<%= query.q || '' %>"
              aria-label="Search listings"
            />
            <button class="btn cm-btn-primary px-4" type="submit">Search</button>
          </div>
          <%# Preserve other active filters %>
          <% if (query.category) { %><input type="hidden" name="category" value="<%= query.category %>" /><% } %>
          <% if (query.condition) { %><input type="hidden" name="condition" value="<%= query.condition %>" /><% } %>
          <% if (query.minPrice)  { %><input type="hidden" name="minPrice"  value="<%= query.minPrice  %>" /><% } %>
          <% if (query.maxPrice)  { %><input type="hidden" name="maxPrice"  value="<%= query.maxPrice  %>" /><% } %>
          <% if (query.college)   { %><input type="hidden" name="college"   value="<%= query.college   %>" /><% } %>
        </form>
        <% if (isAuthenticated) { %>
          <button type="button" class="btn btn-sm btn-outline-light mt-3" id="saveCurrentSearch"
            data-query="<%= query.q || '' %>" data-category="<%= query.category || '' %>"
            data-condition="<%= query.condition || '' %>" data-min-price="<%= query.minPrice || '' %>"
            data-max-price="<%= query.maxPrice || '' %>" data-college="<%= query.college || '' %>">Save this search</button>
        <% } %>
      </div>
      <div class="col-lg-5 d-none d-md-block">
        <div class="cm-hero-stage mx-auto" aria-hidden="true">
          <div class="cm-hero-orbit"></div>
          <div class="cm-hero-photo cm-hero-photo-main">
            <img src="https://images.unsplash.com/photo-1525547719571-a2d4ac8945e2?w=700&amp;auto=format&amp;fit=crop" alt="" fetchpriority="high">
          </div>
          <div class="cm-hero-photo cm-hero-photo-book">
            <img src="https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?w=500&amp;auto=format&amp;fit=crop" alt="" loading="lazy">
          </div>
          <div class="cm-hero-photo cm-hero-photo-camera">
            <img src="https://images.unsplash.com/photo-1516035069371-29a1b244cc32?w=500&amp;auto=format&amp;fit=crop" alt="" loading="lazy">
          </div>
          <div class="cm-hero-float-tag"><i class="bi bi-arrow-left-right me-1"></i>Good finds, nearby</div>
        </div>
      </div>
    </div>
  </div>
</section>

<main class="flex-grow-1 py-5">
  <div class="container">
    <section class="cm-discover-section mb-5" id="discover" aria-labelledby="discoverTitle">
      <div class="d-flex flex-column flex-sm-row align-items-sm-end justify-content-between gap-2 mb-3">
        <div>
          <p class="cm-eyebrow mb-1">EXPLORE YOUR CAMPUS</p>
          <h2 class="cm-section-title mb-0" id="discoverTitle">Discover</h2>
          <p class="text-muted small mb-0">Browse popular categories and campus-only sections.</p>
        </div>
        <a class="cm-link small fw-semibold" href="#listings">View all listings <i class="bi bi-arrow-down"></i></a>
      </div>
      <div class="row row-cols-2 row-cols-md-3 row-cols-xl-5 g-3">
        <% categories.slice(0, 3).forEach(function(category, index) { %>
          <div class="col">
            <a class="cm-discover-card" href="/?category=<%= category._id %>">
              <span class="cm-discover-icon cm-discover-icon-<%= index %>"><i class="bi <%= ['bi-book', 'bi-lightning-charge', 'bi-tools'][index] %>"></i></span>
              <strong><%= category.name %></strong>
              <small>Explore listings <i class="bi bi-arrow-up-right"></i></small>
            </a>
          </div>
        <% }); %>
        <div class="col">
          <a class="cm-discover-card" href="/?listingType=free">
            <span class="cm-discover-icon cm-discover-icon-free"><i class="bi bi-gift"></i></span>
            <strong>Free items</strong>
            <small>Find campus giveaways <i class="bi bi-arrow-up-right"></i></small>
          </a>
        </div>
        <div class="col">
          <a class="cm-discover-card" href="/?listingType=lost">
            <span class="cm-discover-icon cm-discover-icon-lost"><i class="bi bi-search"></i></span>
            <strong>Lost &amp; found</strong>
            <small>Browse campus posts <i class="bi bi-arrow-up-right"></i></small>
          </a>
        </div>
      </div>
      <div class="cm-account-card mt-4">
        <div class="d-flex align-items-start gap-3">
          <span class="cm-discover-icon cm-discover-icon-ai"><i class="bi bi-stars"></i></span>
          <div class="flex-grow-1">
            <h3 class="h6 fw-bold mb-1">Ask about listings</h3>
            <p class="text-muted small mb-3">Describe what you’re looking for or ask how to trade safely on campus.</p>
            <% if (isAuthenticated) { %>
              <form id="assistantForm" class="input-group">
                <input name="question" class="form-control" maxlength="1000" placeholder="Try “Find laptops under ₹30,000”" required>
                <button class="btn cm-btn-primary" type="submit"><i class="bi bi-send me-1"></i>Ask</button>
              </form>
              <div class="d-flex flex-wrap gap-2 mt-2">
                <button type="button" class="btn btn-sm btn-light" data-assistant-example="Find laptops under ₹30,000">Find affordable laptops</button>
                <button type="button" class="btn btn-sm btn-light" data-assistant-example="How do I arrange a safe campus pickup?">Ask about safe pickup</button>
              </div>
              <div id="assistantAnswer" class="mt-3" aria-live="polite"></div>
            <% } else { %>
              <a class="btn btn-sm cm-btn-primary" href="/login?redirect=/">Sign in to ask</a>
            <% } %>
          </div>
        </div>
      </div>
    </section>
    <% if (recommendations && recommendations.length) { %>
      <section class="mb-5" aria-labelledby="personalizedTitle">
        <h2 class="cm-section-title" id="personalizedTitle">Picked for your interests</h2>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3">
          <% recommendations.forEach(function(product) { %><div class="col"><%- include('../partials/product-card', { product }) %></div><% }); %>
        </div>
      </section>
    <% } %>
    <div class="row g-4">

      <!-- ============================================================
           Sidebar — Filters
           ============================================================ -->
      <aside class="col-lg-3">
        <div class="cm-filter-panel">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="cm-filter-title mb-0">Filters</h2>
            <a href="/" class="btn btn-link btn-sm text-muted p-0">Clear all</a>
          </div>

          <form id="filterForm" action="/" method="GET">
            <!-- Preserve search query -->
            <% if (query.q) { %><input type="hidden" name="q" value="<%= query.q %>" /><% } %>
            <div class="mb-4">
              <h3 class="cm-filter-section-title">Marketplace section</h3>
              <select class="form-select form-select-sm" name="listingType">
                <option value="">All listings</option>
                <option value="sale" <%= query.listingType === 'sale' ? 'selected' : '' %>>For sale</option>
                <option value="free" <%= query.listingType === 'free' ? 'selected' : '' %>>Free items</option>
                <option value="lost" <%= query.listingType === 'lost' ? 'selected' : '' %>>Lost</option>
                <option value="found" <%= query.listingType === 'found' ? 'selected' : '' %>>Found</option>
              </select>
            </div>

            <!-- Category -->
            <div class="mb-4">
              <h3 class="cm-filter-section-title">Category</h3>
              <div class="cm-filter-scroll">
                <div class="form-check mb-1">
                  <input
                    class="form-check-input"
                    type="radio"
                    name="category"
                    id="catAll"
                    value=""
                    <%= !query.category ? 'checked' : '' %>
                  />
                  <label class="form-check-label" for="catAll">All Categories</label>
                </div>
                <% categories.forEach(function(cat) { %>
                  <div class="form-check mb-1">
                    <input
                      class="form-check-input"
                      type="radio"
                      name="category"
                      id="cat-<%= cat._id %>"
                      value="<%= cat._id %>"
                      <%= query.category === cat._id.toString() ? 'checked' : '' %>
                    />
                    <label class="form-check-label" for="cat-<%= cat._id %>"><%= cat.name %></label>
                  </div>
                <% }); %>
              </div>
            </div>

            <!-- Condition -->
            <div class="mb-4">
              <h3 class="cm-filter-section-title">Condition</h3>
              <% [['','All'],['new','New'],['like-new','Like New'],['good','Good'],['fair','Fair'],['poor','Poor']].forEach(function(opt) { %>
                <div class="form-check mb-1">
                  <input
                    class="form-check-input"
                    type="radio"
                    name="condition"
                    id="cond-<%= opt[0] || 'all' %>"
                    value="<%= opt[0] %>"
                    <%= query.condition === opt[0] ? 'checked' : (!query.condition && opt[0] === '' ? 'checked' : '') %>
                  />
                  <label class="form-check-label" for="cond-<%= opt[0] || 'all' %>"><%= opt[1] %></label>
                </div>
              <% }); %>
            </div>

            <!-- College -->
            <div class="mb-4">
              <h3 class="cm-filter-section-title">College / School</h3>
              <input
                type="text"
                class="form-control form-control-sm"
                name="college"
                placeholder="Search college name..."
                value="<%= query.college || '' %>"
              />
            </div>

            <!-- Price Range -->
            <div class="mb-4">
              <h3 class="cm-filter-section-title">Price Range (Rs.)</h3>
              <div class="row g-2">
                <div class="col-6">
                  <input
                    type="number"
                    class="form-control form-control-sm"
                    name="minPrice"
                    placeholder="Min"
                    value="<%= query.minPrice || '' %>"
                    min="0"
                  />
                </div>
                <div class="col-6">
                  <input
                    type="number"
                    class="form-control form-control-sm"
                    name="maxPrice"
                    placeholder="Max"
                    value="<%= query.maxPrice || '' %>"
                    min="0"
                  />
                </div>
              </div>
            </div>

            <button type="submit" class="btn cm-btn-primary w-100">Apply Filters</button>
          </form>
        </div>
      </aside>

      <!-- ============================================================
           Main — Product Grid
           ============================================================ -->
      <div class="col-lg-9" id="listings">

        <!-- Results header -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
          <div>
            <h2 class="cm-section-title mb-0">
              <% if (query.q) { %>Results for "<%= query.q %>"<% } else { %>All Listings<% } %>
            </h2>
            <p class="text-muted small mb-0"><%= pagination.total %> item<%= pagination.total !== 1 ? 's' : '' %> found</p>
          </div>
          <!-- Sort -->
          <form action="/" method="GET" class="d-flex align-items-center gap-2">
            <% if (query.q)        { %><input type="hidden" name="q"         value="<%= query.q %>" /><% } %>
            <% if (query.listingType) { %><input type="hidden" name="listingType" value="<%= query.listingType %>" /><% } %>
            <% if (query.category) { %><input type="hidden" name="category"  value="<%= query.category %>" /><% } %>
            <% if (query.condition){ %><input type="hidden" name="condition"  value="<%= query.condition %>" /><% } %>
            <% if (query.minPrice) { %><input type="hidden" name="minPrice"   value="<%= query.minPrice %>" /><% } %>
            <% if (query.maxPrice) { %><input type="hidden" name="maxPrice"   value="<%= query.maxPrice %>" /><% } %>
            <% if (query.college)  { %><input type="hidden" name="college"    value="<%= query.college %>" /><% } %>
            <label class="text-muted small mb-0 text-nowrap" for="sortBySelect">Sort by</label>
            <select id="sortBySelect" name="sortBy" class="form-select form-select-sm cm-sort-select">
              <option value="createdAt" <%= (query.sortBy || 'createdAt') === 'createdAt' ? 'selected' : '' %>>Newest</option>
              <option value="price"     <%= query.sortBy === 'price'     ? 'selected' : '' %>>Price: Low to High</option>
            </select>
            <% if (query.sortBy === 'price') { %>
              <input type="hidden" name="sortOrder" value="asc" />
            <% } %>
          </form>
        </div>

        <!-- Product grid -->
        <% if (products.length === 0) { %>
          <div class="cm-empty-state text-center py-5">
            <i class="bi bi-search" style="font-size:3rem; color:var(--color-muted);"></i>
            <h3 class="mt-3 mb-1">No listings found</h3>
            <p class="text-muted">Try a different search term or remove some filters.</p>
            <a href="/" class="btn cm-btn-outline mt-2">Clear Filters</a>
          </div>
        <% } else { %>
          <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 g-4">
            <% products.forEach(function(product) { %>
              <div class="col">
                <%- include('../partials/product-card', { product }) %>
              </div>
            <% }); %>
          </div>
        <% } %>

        <!-- Pagination -->
        <% if (pagination.pages > 1) { %>
          <nav class="mt-5" aria-label="Listings pagination">
            <ul class="pagination justify-content-center cm-pagination">
              <!-- Previous -->
              <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
                <a class="page-link" href="?<%= new URLSearchParams({...query, page: pagination.page - 1}).toString() %>">&laquo;</a>
              </li>
              <!-- Pages -->
              <% for (let p = 1; p <= pagination.pages; p++) { %>
                <li class="page-item <%= p === pagination.page ? 'active' : '' %>">
                  <a class="page-link" href="?<%= new URLSearchParams({...query, page: p}).toString() %>"><%= p %></a>
                </li>
              <% } %>
              <!-- Next -->
              <li class="page-item <%= pagination.page >= pagination.pages ? 'disabled' : '' %>">
                <a class="page-link" href="?<%= new URLSearchParams({...query, page: pagination.page + 1}).toString() %>">&raquo;</a>
              </li>
            </ul>
          </nav>
        <% } %>

      </div><!-- /col-lg-9 -->
    </div><!-- /row -->
  </div><!-- /container -->
</main>

<%- include('../partials/footer') %>

<!-- Bootstrap 5 JS -->
<script
  src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
  integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
  crossorigin="anonymous"
></script>
<script src="/js/main.js"></script>

</body>
</html>
