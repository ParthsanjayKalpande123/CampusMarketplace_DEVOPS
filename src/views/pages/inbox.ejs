<!DOCTYPE html>
<html lang="en" class="h-100">
<%- include('../partials/head', { title }) %>
<body class="d-flex flex-column h-100 cm-bg">

<%- include('../partials/navbar') %>

<main class="flex-grow-1 py-4">
  <div class="container h-100">
    <div class="card shadow-sm h-100 border-0 overflow-hidden" style="min-height: 500px; max-height: calc(100vh - 160px);">
      <div class="row g-0 h-100">
        
        <!-- ============================================================
             Left Sidebar: Conversations List
             ============================================================ -->
        <div class="col-md-4 border-end d-flex flex-column h-100 bg-white">
          <div class="p-3 border-bottom">
            <h5 class="fw-semibold mb-0"><i class="bi bi-chat-left-text me-2"></i>My Chats</h5>
          </div>
          <div class="flex-grow-1 overflow-y-auto" style="max-height: calc(100vh - 220px);">
            <% if (conversations.length === 0 && !activeChatUser) { %>
              <div class="text-center p-4 text-muted">
                <i class="bi bi-chat-dots" style="font-size: 2.5rem;"></i>
                <p class="mt-2 mb-0 small">No messages yet.</p>
              </div>
            <% } else { %>
              <div class="list-group list-group-flush">
                <!-- If we initiated a new chat that isn't in the list yet -->
                <% if (activeChatUser && !conversations.some(c => c.otherUser._id.toString() === activeChatUser._id.toString())) { %>
                  <a href="/inbox?userId=<%= activeChatUser._id %><%= activeProduct ? '&productId=' + activeProduct._id : '' %>" 
                     class="list-group-item list-group-item-action p-3 active border-bottom">
                    <div class="d-flex align-items-center gap-3">
                      <div class="cm-seller-avatar cm-seller-avatar-sm d-flex align-items-center justify-content-center bg-primary text-white">
                        <i class="bi bi-person-fill"></i>
                      </div>
                      <div class="flex-grow-1 min-width-0">
                        <div class="d-flex justify-content-between align-items-baseline">
                          <h6 class="mb-0 text-truncate fw-semibold"><%= activeChatUser.name %></h6>
                        </div>
                        <p class="mb-0 text-truncate text-white-50 small">New conversation...</p>
                      </div>
                    </div>
                  </a>
                <% } %>

                <% conversations.forEach(function(conv) { %>
                  <% 
                    const isActive = activeChatUser && activeChatUser._id.toString() === conv.otherUser._id.toString();
                    const lastMsg = conv.lastMessage;
                  %>
                  <a href="/inbox?userId=<%= conv.otherUser._id %><%= conv.product ? '&productId=' + conv.product._id : '' %>" 
                     class="list-group-item list-group-item-action p-3 border-bottom <%= isActive ? 'active' : '' %>">
                    <div class="d-flex align-items-center gap-3">
                      <div class="cm-seller-avatar cm-seller-avatar-sm d-flex align-items-center justify-content-center <%= isActive ? 'bg-white text-primary' : 'bg-light text-dark' %>">
                        <i class="bi bi-person-fill"></i>
                      </div>
                      <div class="flex-grow-1 min-width-0">
                        <div class="d-flex justify-content-between align-items-baseline">
                          <h6 class="mb-0 text-truncate fw-semibold <%= isActive ? 'text-white' : '' %>"><%= conv.otherUser.name %></h6>
                          <span class="text-muted small text-nowrap <%= isActive ? 'text-white-50' : '' %>" style="font-size: 0.7rem;">
                            <%= lastMsg ? new Date(lastMsg.createdAt).toLocaleTimeString('en-US', {hour: '2-digit', minute:'2-digit'}) : '' %>
                          </span>
                        </div>
                        <p class="mb-0 text-truncate small <%= isActive ? 'text-white-50' : 'text-muted' %>">
                          <% if (lastMsg.sender.toString() === user._id.toString()) { %>
                            You: 
                          <% } %>
                          <%= lastMsg.content %>
                        </p>
                      </div>
                    </div>
                  </a>
                <% }); %>
              </div>
            <% } %>
          </div>
        </div>

        <!-- ============================================================
             Right Section: Chat Thread
             ============================================================ -->
        <div class="col-md-8 d-flex flex-column h-100 bg-light">
          <% if (activeChatUser) { %>
            <!-- Chat Header -->
            <div class="p-3 border-bottom bg-white d-flex align-items-center justify-content-between">
              <div>
                <h6 class="fw-bold mb-0"><%= activeChatUser.name %></h6>
                <small class="text-muted"><%= activeChatUser.college || 'Campus Community' %></small>
              </div>
              <% if (activeProduct) { %>
                <div class="d-flex align-items-center gap-2 bg-light p-2 rounded border" style="max-width: 250px;">
                  <div class="flex-grow-1 min-width-0">
                    <p class="fw-semibold mb-0 small text-truncate"><a href="/listings/<%= activeProduct._id %>" class="text-decoration-none text-dark"><%= activeProduct.title %></a></p>
                    <small class="text-primary fw-bold">Rs. <%= activeProduct.price.toLocaleString('en-IN') %></small>
                  </div>
                </div>
              <% } %>
            </div>

            <!-- Messages List -->
            <div id="chatFeed" class="flex-grow-1 p-3 overflow-y-auto" style="height: calc(100vh - 330px); background-color: #f8f9fa;">
              <div class="d-flex flex-column gap-3">
                <% if (messages.length === 0) { %>
                  <div class="text-center py-5 text-muted">
                    <i class="bi bi-chat-right-quote" style="font-size: 2rem;"></i>
                    <p class="mt-2 mb-0 small">Send a message to start negotiating!</p>
                  </div>
                <% } else { %>
                  <% messages.forEach(function(msg) { %>
                    <% const isMe = msg.sender._id.toString() === user._id.toString(); %>
                    <div class="d-flex <%= isMe ? 'justify-content-end' : 'justify-content-start' %>">
                      <div class="max-width-70 rounded p-3 shadow-sm <%= isMe ? 'bg-primary text-white' : 'bg-white text-dark' %>" style="border-radius: 12px; max-width: 75%;">
                        <p class="mb-1 small" style="white-space: pre-wrap;"><%= msg.content %></p>
                        <div class="text-end" style="font-size: 0.65rem; opacity: 0.75;">
                          <%= new Date(msg.createdAt).toLocaleTimeString('en-US', {hour: '2-digit', minute:'2-digit'}) %>
                        </div>
                      </div>
                    </div>
                  <% }); %>
                <% } %>
              </div>
            </div>

            <!-- Message Form -->
            <div class="p-3 border-top bg-white">
              <form id="chatForm">
                <input type="hidden" id="receiverId" value="<%= activeChatUser._id %>" />
                <input type="hidden" id="productId" value="<%= activeProduct ? activeProduct._id : '' %>" />
                <div class="input-group">
                  <textarea 
                    id="messageContent" 
                    class="form-control" 
                    rows="1" 
                    placeholder="Type your message here..." 
                    maxlength="1000" 
                    required
                  ></textarea>
                  <button type="submit" id="sendBtn" class="btn cm-btn-primary px-4">
                    <i class="bi bi-send-fill"></i>
                  </button>
                </div>
              </form>
            </div>

          <% } else { %>
            <!-- Placeholder state -->
            <div class="flex-grow-1 d-flex flex-column align-items-center justify-content-center text-muted p-5">
              <i class="bi bi-chat-left-dots" style="font-size: 4rem;"></i>
              <h5 class="mt-3 fw-semibold">Your Conversations</h5>
              <p class="small">Select a conversation from the sidebar to start chatting.</p>
            </div>
          <% } %>
        </div>

      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>

<script
  src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
  integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
  crossorigin="anonymous"
></script>
<script src="/js/main.js"></script>
<% if (activeChatUser) { %>
  <script src="/js/inbox.js"></script>
<% } %>

</body>
</html>
