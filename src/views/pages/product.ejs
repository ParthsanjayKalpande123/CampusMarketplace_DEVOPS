<!DOCTYPE html>
<html lang="en" class="h-100">
<%- include('../partials/head', { title }) %>
<body class="d-flex flex-column h-100 cm-bg">

<%- include('../partials/navbar') %>

<main class="flex-grow-1 py-5">
  <div class="container">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/" class="cm-link">Home</a></li>
        <% if (product.category) { %>
          <li class="breadcrumb-item">
            <a href="/?category=<%= product.category._id %>" class="cm-link"><%= product.category.name %></a>
          </li>
        <% } %>
        <li class="breadcrumb-item active" aria-current="page"><%= product.title %></li>
      </ol>
    </nav>

    <div class="row g-5">

      <!-- Left: Image -->
      <div class="col-lg-6">
        <div class="cm-product-image-wrap">
          <% if (product.imageUrl) { %>
            <img
              src="<%= product.imageUrl %>"
              alt="<%= product.title %>"
              class="cm-product-main-image"
              onerror="this.src='/img/placeholder.svg'"
            />
          <% } else { %>
            <div class="cm-product-image-placeholder d-flex align-items-center justify-content-center">
              <div class="text-center text-muted">
                <i class="bi bi-image" style="font-size:4rem;"></i>
                <p class="mt-2 mb-0">No image provided</p>
              </div>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Right: Details -->
      <div class="col-lg-6">

        <!-- Status + Condition badges -->
        <div class="d-flex flex-wrap gap-2 mb-3">
          <%
            const statusMap = {
              'available': ['bg-success',  'Available'],
              'reserved':  ['bg-warning text-dark', 'Reserved'],
              'sold':      ['bg-secondary','Sold'],
              'exchanged': ['bg-info text-dark','Exchanged'],
              'inactive':  ['bg-warning text-dark','Inactive'],
            };
            const [statusCls, statusLabel] = statusMap[product.status] || statusMap['available'];
            const condMap = { 'new':'New','like-new':'Like New','good':'Good','fair':'Fair','poor':'Poor' };
          %>
          <span class="badge <%= statusCls %> cm-detail-badge"><%= statusLabel %></span>
          <span class="badge bg-light text-dark cm-detail-badge border"><%= condMap[product.condition] || product.condition %></span>
          <% if (product.isExchangeable) { %>
            <span class="badge bg-light text-primary cm-detail-badge border border-primary">
              <i class="bi bi-arrow-left-right me-1"></i>Open to Exchange
            </span>
          <% } %>
          <% if (product.listingType === 'free' || product.price === 0) { %><span class="badge bg-success cm-detail-badge">FREE</span><% } %>
          <% if (product.listingType === 'lost' || product.listingType === 'found') { %><span class="badge bg-warning text-dark cm-detail-badge"><%= product.listingType.toUpperCase() %> ITEM</span><% } %>
          <% if (product.seller.collegeVerified) { %><span class="badge bg-primary"><i class="bi bi-patch-check-fill"></i> Verified Student</span><% } %>
        </div>

        <h1 class="cm-product-detail-title mb-1"><%= product.title %></h1>
        <p class="text-muted small mb-3">
          Listed <%= product.createdAt ? new Date(product.createdAt).toLocaleDateString('en-IN', { day:'numeric', month:'long', year:'numeric' }) : '' %>
        </p>
        <% if (product.lostFoundDate) { %><p class="small text-muted">Lost/found date: <%= new Date(product.lostFoundDate).toLocaleDateString('en-IN') %></p><% } %>

        <div class="cm-detail-price mb-4">
          Rs. <%= product.price.toLocaleString('en-IN') %>
        </div>

        <!-- Description -->
        <div class="mb-4">
          <h2 class="cm-detail-section-title">Description</h2>
          <p class="cm-detail-description"><%= product.description %></p>
          <% if (product.tags && product.tags.length) { %><div class="d-flex flex-wrap gap-1"><% product.tags.forEach(function(tag) { %><span class="badge bg-light text-dark">#<%= tag %></span><% }); %></div><% } %>
        </div>

        <!-- Location -->
        <% if (product.location) { %>
          <div class="mb-4">
            <h2 class="cm-detail-section-title">Location</h2>
            <p class="mb-0"><i class="bi bi-geo-alt me-1 text-muted"></i><%= product.location %></p>
          </div>
        <% } %>
        <% if (product.pickupLocation || product.pickupAvailability) { %>
          <div class="mb-4">
            <h2 class="cm-detail-section-title">Campus pickup</h2>
            <% if (product.pickupLocation) { %><p class="mb-1"><strong>Location:</strong> <%= product.pickupLocation %></p><% } %>
            <% if (product.pickupAvailability) { %><p class="mb-0"><strong>Availability:</strong> <%= product.pickupAvailability %></p><% } %>
          </div>
        <% } %>
        <% if (product.details && product.details.size) { %>
          <div class="mb-4"><h2 class="cm-detail-section-title">Item details</h2>
            <dl class="row"><% for (const [key, value] of product.details) { %><dt class="col-4 text-capitalize"><%= key %></dt><dd class="col-8"><%= value %></dd><% } %></dl>
          </div>
        <% } %>
        <section class="cm-credibility-card mb-4" aria-labelledby="credibilityTitle">
          <div class="d-flex align-items-start gap-3">
            <span class="cm-discover-icon cm-discover-icon-ai"><i class="bi bi-shield-check"></i></span>
            <div class="flex-grow-1">
              <h2 class="h6 fw-bold mb-1" id="credibilityTitle">AI listing credibility check</h2>
              <p class="small text-muted mb-3">Check the title, price, description, and item details for signs that need a closer look. This is only an advisory signal—not proof that an item is genuine or fake.</p>
              <% if (isAuthenticated) { %>
                <button class="btn btn-sm btn-outline-primary" type="button" id="checkListingCredibility" data-product-id="<%= product._id %>">
                  <i class="bi bi-shield-check me-1"></i>Check this listing
                </button>
                <div id="listingCredibilityResult" class="mt-3" aria-live="polite"></div>
              <% } else { %>
                <a class="btn btn-sm btn-outline-primary" href="/login?redirect=/listings/<%= product._id %>">Sign in to check this listing</a>
              <% } %>
            </div>
          </div>
        </section>
        <% if (isAuthenticated) { %>
          <div class="mb-4">
            <button class="btn btn-sm btn-outline-secondary" type="button" data-compare-add="<%= product._id %>">Add to comparison</button>
            <button class="btn btn-sm btn-outline-primary" type="button" data-compare-open>Compare selected</button>
            <span class="small text-muted ms-2" data-compare-count aria-live="polite"></span>
          </div>
        <% } %>

        <!-- Seller info -->
        <div class="cm-seller-card mb-4">
          <h2 class="cm-detail-section-title mb-3">Seller</h2>
          <div class="d-flex align-items-center gap-3">
            <div class="cm-seller-avatar d-flex align-items-center justify-content-center">
              <i class="bi bi-person-fill"></i>
            </div>
            <div>
              <p class="fw-semibold mb-0"><%= product.seller.name %></p>
              <% if (product.seller.college) { %>
                <p class="text-muted small mb-0"><%= product.seller.college %></p>
              <% } %>
              <p class="small mb-0">Seller rating: <%= sellerRating.average ? `${sellerRating.average.toFixed(1)} / 5 (${sellerRating.count})` : 'No reviews yet' %></p>
            </div>
          </div>
          <% if (product.seller.phone) { %>
            <div class="mt-3">
              <a href="tel:<%= product.seller.phone %>" class="btn cm-btn-outline w-100">
                <i class="bi bi-telephone me-2"></i>Contact Seller
              </a>
            </div>
          <% } %>
        </div>

        <!-- Action buttons -->
        <% if (isOwner) { %>
          <div class="d-grid gap-2">
            <% if (product.aiReviewStatus === 'pending-review') { %><div class="alert alert-warning">Flagged for administrator review: <%= product.aiRiskFlags.join(', ') %></div><% } %>
            <a href="/listings/<%= product._id %>/edit" class="btn cm-btn-primary">
              <i class="bi bi-pencil me-2"></i>Edit Listing
            </a>
            <!-- Status quick-update -->
            <% if (product.status === 'available') { %>
              <button
                class="btn cm-btn-outline"
                data-action="update-status"
                data-product-id="<%= product._id %>"
                data-status="sold"
              >
                <i class="bi bi-check-circle me-2"></i>Mark as Sold
              </button>
            <% } %>
            <button
              class="btn btn-outline-danger"
              data-action="delete-product"
              data-product-id="<%= product._id %>"
            >
              <i class="bi bi-trash me-2"></i>Delete Listing
            </button>
          </div>
        <% } else if (isAuthenticated && product.status === 'available') { %>
          <button class="btn btn-outline-danger w-100 mb-2" type="button" data-add-wishlist="<%= product._id %>"><i class="bi bi-heart"></i> Add to Wishlist</button>
          <a
            href="/inbox?userId=<%= product.seller._id %>&productId=<%= product._id %>"
            class="btn cm-btn-primary w-100 mb-2"
          >
            <i class="bi bi-chat-left-text me-2"></i>Chat with Seller
          </a>
          <form id="offerForm" class="card card-body mb-2">
            <h2 class="h6">Make an offer</h2>
            <label class="form-label small" for="offerAmount">Offer price (₹)</label>
            <input class="form-control mb-2" id="offerAmount" type="number" min="0" max="999999" value="<%= product.price %>" required>
            <% if (myProducts.length) { %>
              <label class="form-label small" for="exchangeProduct">Or propose an exchange</label>
              <select class="form-select mb-2" id="exchangeProduct"><option value="">Price offer</option>
                <% myProducts.filter(p => p.status === 'available').forEach(function(ownProduct) { %>
                  <option value="<%= ownProduct._id %>"><%= ownProduct.title %></option>
                <% }); %>
              </select>
              <input class="form-control mb-2" id="additionalCash" type="number" min="0" placeholder="Optional extra cash (₹)">
            <% } %>
            <textarea class="form-control mb-2" id="offerMessage" maxlength="500" placeholder="Message to seller (optional)"></textarea>
            <button class="btn cm-btn-primary" type="submit">Send offer</button>
          </form>
          <button class="btn btn-outline-secondary w-100 mb-2" type="button" id="reportSellerBtn" data-seller-id="<%= product.seller._id %>">Report seller</button>
          <button class="btn btn-outline-dark w-100 mb-2" type="button" id="blockSellerBtn" data-seller-id="<%= product.seller._id %>">Block seller</button>
          <button
            class="btn btn-outline-warning w-100"
            data-action="report-product"
            data-product-id="<%= product._id %>"
          >
            <i class="bi bi-flag me-2"></i>Report this Listing
          </button>
        <% } else if (!isAuthenticated) { %>
          <a href="/login?redirect=/listings/<%= product._id %>" class="btn cm-btn-outline w-100">
            Login to Contact Seller
          </a>
        <% } %>

      </div><!-- /col-lg-6 -->
    </div><!-- /row -->
  </div><!-- /container -->
</main>

<% if (productReviews.length) { %>
  <section class="container mb-5"><h2 class="h4">Product reviews</h2>
    <% productReviews.forEach(function(review) { %>
      <div class="border-bottom py-2"><strong><%= review.rating %>/5</strong> <%= review.text || 'Rating only' %> <span class="text-muted">— <%= review.author ? review.author.name : 'Student' %></span></div>
    <% }); %>
  </section>
<% } %>

<% if (similarProducts.length) { %>
  <section class="container mb-5"><h2 class="h4">Similar listings</h2>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3">
      <% similarProducts.forEach(function(similar) { %><div class="col"><%- include('../partials/product-card', { product: similar }) %></div><% }); %>
    </div>
  </section>
<% } %>

<!-- Report Modal -->
<% if (isAuthenticated && !isOwner) { %>
<div class="modal fade" id="reportModal" tabindex="-1" aria-labelledby="reportModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content cm-modal">
      <div class="modal-header border-0">
        <h5 class="modal-title fw-semibold" id="reportModalLabel">Report Listing</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div id="reportAlert" class="alert d-none"></div>
        <div class="mb-3">
          <label for="reportReason" class="form-label fw-medium">Reason</label>
          <select class="form-select" id="reportReason">
            <option value="">Select a reason</option>
            <option value="spam">Spam</option>
            <option value="inappropriate">Inappropriate content</option>
            <option value="wrong_price">Wrong price</option>
            <option value="item_unavailable">Item no longer available</option>
            <option value="fraud">Suspected fraud</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div class="mb-3">
          <label for="reportDescription" class="form-label fw-medium">Additional details <span class="text-muted">(optional)</span></label>
          <textarea class="form-control" id="reportDescription" rows="3" maxlength="500"
            placeholder="Describe the issue..."></textarea>
        </div>
      </div>
      <div class="modal-footer border-0">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn cm-btn-danger" id="submitReportBtn"
          data-product-id="<%= product._id %>">Submit Report</button>
      </div>
    </div>
  </div>
</div>
<% } %>

<!-- Delete confirm modal -->
<% if (isOwner) { %>
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-sm">
    <div class="modal-content cm-modal">
      <div class="modal-body text-center py-4">
        <i class="bi bi-exclamation-triangle text-danger mb-3" style="font-size:2.5rem;"></i>
        <h5 class="fw-semibold">Delete this listing?</h5>
        <p class="text-muted small">This action cannot be undone.</p>
        <div class="d-grid gap-2 mt-3">
          <button type="button" class="btn cm-btn-danger" id="confirmDeleteBtn"
            data-product-id="<%= product._id %>">Yes, Delete</button>
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        </div>
      </div>
    </div>
  </div>
</div>
<% } %>

<%- include('../partials/footer') %>

<script
  src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
  integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
  crossorigin="anonymous"
></script>
<script src="/js/main.js"></script>
<script src="/js/listing.js"></script>

</body>
</html>
