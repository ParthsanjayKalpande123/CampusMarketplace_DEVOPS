<!DOCTYPE html>
<html lang="en" class="h-100">
<%- include('../partials/head', { title }) %>
<body class="d-flex flex-column h-100 cm-bg">

<%- include('../partials/navbar') %>

<main class="flex-grow-1 py-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12 col-lg-8">

        <h1 class="cm-page-title mb-4">My Profile</h1>

        <div id="profileAlert" class="alert d-none"></div>

        <ul class="nav nav-tabs cm-profile-tabs mb-3" id="profileTabs" role="tablist">
          <li class="nav-item" role="presentation"><button class="nav-link active" id="profile-details-tab" data-bs-toggle="tab" data-bs-target="#profile-details" type="button" role="tab" aria-controls="profile-details" aria-selected="true"><i class="bi bi-person me-1"></i>Personal details</button></li>
          <li class="nav-item" role="presentation"><button class="nav-link" id="profile-verification-tab" data-bs-toggle="tab" data-bs-target="#profile-verification" type="button" role="tab" aria-controls="profile-verification" aria-selected="false"><i class="bi bi-patch-check me-1"></i>Verification</button></li>
          <li class="nav-item" role="presentation"><button class="nav-link" id="profile-reputation-tab" data-bs-toggle="tab" data-bs-target="#profile-reputation" type="button" role="tab" aria-controls="profile-reputation" aria-selected="false"><i class="bi bi-star me-1"></i>Reputation</button></li>
          <li class="nav-item" role="presentation"><button class="nav-link" id="profile-account-tab" data-bs-toggle="tab" data-bs-target="#profile-account" type="button" role="tab" aria-controls="profile-account" aria-selected="false"><i class="bi bi-gear me-1"></i>Account</button></li>
        </ul>

        <div class="tab-content cm-profile-tab-content" id="profileTabContent">
        <section class="tab-pane fade show active" id="profile-details" role="tabpanel" aria-labelledby="profile-details-tab" tabindex="0">
        <div class="cm-form-card mb-4">
          <h2 class="cm-detail-section-title mb-4">Personal Information</h2>
          <form id="profileForm" novalidate>

            <div class="row g-3">
              <div class="col-md-6">
                <label for="name" class="form-label fw-medium">Full Name</label>
                <input
                  type="text"
                  class="form-control cm-form-control"
                  id="name"
                  value="<%= user.name %>"
                  maxlength="100"
                />
              </div>
              <div class="col-md-6">
                <label for="email" class="form-label fw-medium">Email Address</label>
                <input
                  type="email"
                  class="form-control cm-form-control"
                  id="email"
                  value="<%= user.email %>"
                  disabled
                  title="Email cannot be changed"
                />
                <div class="form-text">Email address cannot be changed.</div>
              </div>
              <div class="col-md-6">
                <label for="college" class="form-label fw-medium">College / Institution</label>
                <input
                  type="text"
                  class="form-control cm-form-control"
                  id="college"
                  value="<%= user.college || '' %>"
                  placeholder="e.g. IIT Bombay"
                  maxlength="200"
                />
              </div>
              <div class="col-md-6">
                <label for="department" class="form-label fw-medium">Department</label>
                <input type="text" class="form-control cm-form-control" id="department" value="<%= user.department || '' %>" maxlength="120" placeholder="e.g. Computer Engineering">
              </div>
              <div class="col-md-6">
                <label for="year" class="form-label fw-medium">Year of Study</label>
                <input type="text" class="form-control cm-form-control" id="year" value="<%= user.year || '' %>" maxlength="40" placeholder="e.g. Second year">
              </div>
              <div class="col-md-6">
                <label for="phone" class="form-label fw-medium">Phone Number</label>
                <input
                  type="tel"
                  class="form-control cm-form-control"
                  id="phone"
                  value="<%= user.phone || '' %>"
                  placeholder="+91 98765 43210"
                  maxlength="20"
                />
                <div class="form-text">Displayed to buyers on your listings.</div>
              </div>
              <div class="col-12">
                <label for="profileImage" class="form-label fw-medium">Profile Image URL <span class="text-muted">(optional)</span></label>
                <input
                  type="url"
                  class="form-control cm-form-control"
                  id="profileImage"
                  value="<%= user.profileImage || '' %>"
                  placeholder="https://example.com/your-photo.jpg"
                />
              </div>
            </div>

            <div class="mt-4">
              <button type="submit" class="btn cm-btn-primary" id="saveProfileBtn">Save Changes</button>
            </div>

          </form>
        </div>
        </section>

        <section class="tab-pane fade" id="profile-verification" role="tabpanel" aria-labelledby="profile-verification-tab" tabindex="0">
        <div class="cm-form-card mb-4">
          <h2 class="cm-detail-section-title mb-3">College Verification</h2>
          <% if (user.collegeVerified) { %>
            <p class="text-success"><i class="bi bi-patch-check-fill"></i> Verified student — <%= user.college %></p>
          <% } else { %>
            <p class="text-muted">A verified student badge helps other campus users identify you. Email delivery is not configured yet, so verification cannot be completed in this environment.</p>
            <form id="verificationForm" class="row g-2">
              <div class="col-md-5"><input type="email" id="collegeEmail" class="form-control" value="<%= user.collegeEmail || '' %>" placeholder="you@college.edu" required></div>
              <div class="col-md-5"><input type="text" id="verificationCollege" class="form-control" value="<%= user.college || '' %>" placeholder="College name" required></div>
              <div class="col-md-2"><button class="btn btn-outline-primary w-100">Request verification</button></div>
            </form>
            <div id="verificationAlert" class="mt-2 small text-muted"></div>
          <% } %>
        </div>
        </section>

        <section class="tab-pane fade" id="profile-reputation" role="tabpanel" aria-labelledby="profile-reputation-tab" tabindex="0">
        <div class="cm-form-card mb-4">
          <h2 class="cm-detail-section-title">Seller Reputation</h2>
          <p class="mb-1">Average rating: <%= profileStats.averageRating ? `${profileStats.averageRating.toFixed(1)} / 5` : 'No reviews yet' %> (<%= profileStats.reviewCount %> reviews)</p>
          <p class="mb-1">Completed sales: <%= profileStats.sold %> · Purchases: <%= profileStats.bought %></p>
          <p class="mb-0">Marketplace trust score: <%= profileStats.trustScore %> / 100</p>
          <% if (profileStats.sellerReviews.length) { %>
            <hr><% profileStats.sellerReviews.forEach(function(review) { %>
              <p class="mb-1"><strong><%= review.rating %>/5</strong> — <%= review.text || 'Rating only' %> <span class="text-muted">by <%= review.author ? review.author.name : 'Student' %></span></p>
            <% }); %>
          <% } %>
        </div>
        </section>

        <section class="tab-pane fade" id="profile-account" role="tabpanel" aria-labelledby="profile-account-tab" tabindex="0">
        <!-- Account info (read-only) -->
        <div class="cm-form-card">
          <h2 class="cm-detail-section-title mb-4">Account Information</h2>
          <dl class="row mb-0">
            <dt class="col-sm-4 text-muted fw-normal">Account type</dt>
            <dd class="col-sm-8 fw-medium text-capitalize"><%= user.role %></dd>
            <dt class="col-sm-4 text-muted fw-normal">Member since</dt>
            <dd class="col-sm-8">
              <%= user.createdAt ? new Date(user.createdAt).toLocaleDateString('en-IN', {day:'numeric',month:'long',year:'numeric'}) : 'N/A' %>
            </dd>
          </dl>
          <hr />
          <div class="d-flex justify-content-between align-items-center">
            <a href="/my-listings" class="btn btn-sm btn-light">
              <i class="bi bi-list-ul me-1"></i>View My Listings
            </a>
            <button class="btn btn-sm btn-outline-danger" id="logoutBtnProfile">
              <i class="bi bi-box-arrow-right me-1"></i>Logout
            </button>
          </div>
        </div>
        </section>
        </div>

      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>

<script
  src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
  integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
  crossorigin="anonymous"
></script>
<script src="/js/main.js"></script>
<script src="/js/profile.js"></script>

</body>
</html>
